# Names only. Configure real values in your host's server-side secret settings.
# Never add NEXT_PUBLIC_ / VITE_ prefixes to these variables.
OPENAI_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Existing AgentPhone account resources; keys remain server-side.
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
AGENTPHONE_WEBHOOK_SECRET=
# Comma-separated, independently checked payment destinations, in E.164 format.
AGENTPHONE_ALLOWED_NUMBERS=
# Non-sensitive reference to a separately configured, authorised payment capability.
# Never put card numbers or CVC here. A Stripe PaymentMethod ID is not an IVR card.
AGENTPHONE_PAYMENT_REFERENCE=
STRIPE_MODE=test
